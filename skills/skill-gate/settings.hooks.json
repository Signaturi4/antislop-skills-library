{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 \"$HOME/.claude/hooks/skill-gate/on_prompt.py\"", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [ { "type": "command", "command": "python3 \"$HOME/.claude/hooks/skill-gate/pre_tool.py\"", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Skill|Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [ { "type": "command", "command": "python3 \"$HOME/.claude/hooks/skill-gate/post_tool.py\"", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 \"$HOME/.claude/hooks/skill-gate/on_stop.py\"", "timeout": 10 } ] }
    ]
  }
}
